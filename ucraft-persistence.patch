@@ -2,5 +2,17 @@
 #define _UCRAFT_H
 #include <stdint.h>
 extern size_t main_tick;
+
+// Must be called (if at all) BEFORE UCraftStart(). Overrides the compile
+// time PORT define from config.h.
+void UCraftSetPort(int port);
+
+// Must be called (if at all) BEFORE UCraftStart(). When set, the world's
+// block diffs are loaded from this path on startup (if it exists) and
+// written back to it on clean shutdown + periodic autosave. The string is
+// NOT copied, so it must stay valid for the lifetime of the server (e.g.
+// pass argv[i] directly).
+void UCraftSetSavePath(const char *path);
+
 int UCraftStart(uint8_t *cleanup_flag);
 #endif
