+
+// Persistence: dumps/restores only the block *diffs* (player placed/broken
+// blocks) that live in the coordinate hashmap. The procedurally generated
+// terrain itself is never stored, only recreated on the fly (see world.c),
+// so save files stay tiny even for large worlds.
+bool blocksSave(const char *path);
+bool blocksLoad(const char *path);
 #endif
